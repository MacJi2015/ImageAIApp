# Use git Specs repo (mirror) to avoid CDN connectivity issues in some networks.
# If one mirror is slow/unreachable, switch to another mirror URL.
source 'https://gitee.com/mirrors/CocoaPods-Specs.git'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# 与 node_modules 里 RNFB 声明的 ios firebase 版本严格一致；勿手写版本号，避免与锁文件/升级不同步。
# 若出现 “In snapshot (Podfile.lock): Firebase/CoreOnly (= x) … RNFBApp … (= y)”：删除 ios/Podfile.lock 后重新 pod install，
# 或执行：bundle exec pod update Firebase/CoreOnly Firebase/Auth
begin
  require 'json'
  rnfb = File.join(__dir__, '..', 'node_modules', '@react-native-firebase', 'app', 'package.json')
  if File.exist?(rnfb)
    fb_ios = JSON.parse(File.read(rnfb)).dig('sdkVersions', 'ios', 'firebase')
    $FirebaseSDKVersion = fb_ios if fb_ios
  end
end

prepare_react_native_project!

# Firebase 等 Swift pods 依赖的库需要生成 module map（静态库时）
use_modular_headers!

# glog configure fails for device SDK ("C compiler cannot create executables"); use simulator SDK during pod install
pre_install do |installer|
  %w[
    HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
    http_proxy https_proxy all_proxy no_proxy
  ].each { |k| ENV.delete(k) }
  ENV['PLATFORM_NAME'] = 'iphonesimulator'
end

# React Native Firebase 需要 use_frameworks! 才能正确生成 FirebaseAuth-Swift.h
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'ImageAIApp' do
  config = use_native_modules!

  # 国内网络：用 GitHub 镜像拉取 Facebook SDK，避免直接从 GitHub 下载时 Connection reset by peer
  pod 'FBAEMKit', :podspec => File.join(__dir__, 'OverridePods', 'FBAEMKit.podspec')
  # Some setups (notably with use_frameworks!/modular_headers) can cause Bootsplash to be skipped by autolinking.
  # Add it explicitly so the `RNBootSplash` Swift module is always available to `AppDelegate.swift`.
  pod 'RNBootSplash', :path => '../node_modules/react-native-bootsplash'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # 修复 RNFB "Include of non-modular header inside framework module"
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
    # Pods 工程级别也开启，确保所有子 target 继承
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
    # 主工程 ImageAIApp 也开启，避免链接/编译时仍报错
    main_project_path = File.join(installer.sandbox.root.parent, 'ImageAIApp.xcodeproj')
    if File.exist?(main_project_path)
      main_project = Xcodeproj::Project.open(main_project_path)
      main_project.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        end
      end
      main_project.save
    end
  end
end
